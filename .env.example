# Copia este archivo a .env y ajusta los valores según tu entorno.
# Bun carga .env automáticamente al correr la app.

# URL base del servidor Ollama (API en /api/chat).
OLLAMA_HOST=http://localhost:11434

# Modelo local usado para el análisis de gastos (debe estar descargado: ollama pull <modelo>).
AI_MODEL=llama3.2

# Ruta de la base de datos SQLite. El MCP server la usa para abrir la misma DB que la app.
DB_PATH=.data/expenses.db